[user]
  name       = YOUR_NAME
  email      = YOUR_EMAIL
  signingkey = YOUR_SSH_KEY

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers
  program            = YOUR_OPENSSH_KEYGEN

[commit]
  gpgsign  = true
  template = YOUR_DOTFILES_DIR/git/commit-template

[tag]
  gpgsign = true

[pull]
  rebase = true

[core]
  editor    = code --wait
  autocrlf  = input
  hooksPath = YOUR_DOTFILES_DIR/scripts/hooks

[init]
  defaultBranch = main
