# ------------------------------------------------------------
# ZSH bootstrap loader
# ------------------------------------------------------------
# Minimal loader that sources all modular shell configuration
# files from ~/.dotfiles/shell.
#
# Modules are loaded alphabetically.
# Numeric prefixes enforce deterministic order:
#   10-base.zsh
#   20-exports.zsh
#   30-paths.zsh
#   40-aliases.zsh
#
# The (N) glob modifier prevents errors if no files exist.
# ------------------------------------------------------------

# Prevent double loading
[[ -n "${DOTFILES_BOOTSTRAPPED:-}" ]] && return
DOTFILES_BOOTSTRAPPED=1

DOTFILES_SHELL_DIR="$HOME/.dotfiles/shell"

if [[ -d "$DOTFILES_SHELL_DIR" ]]; then
  local file
  for file in "$DOTFILES_SHELL_DIR"/*.zsh(N); do
    [[ -r "$file" ]] && source "$file"
  done
fi